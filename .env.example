# ============================================
# MongoDB (required for user data)
# Get from: https://cloud.mongodb.com (free M0 cluster)
# ============================================
MONGODB_URI=

# ============================================
# JWT (required for authentication)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================
JWT_SECRET=

# ============================================
# Google OAuth (required for "Continue with Google")
# Get from: https://console.cloud.google.com/apis/credentials
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# Lemon Squeezy (payments)
# ============================================
VITE_LEMONSQUEEZY_STORE_ID=
VITE_LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Lemon Squeezy Product Variants
VITE_LS_PRO_MONTHLY_VARIANT_ID=
VITE_LS_PRO_YEARLY_VARIANT_ID=
VITE_LS_SINGLE_MODEL_VARIANT_ID=

# ============================================
# App
# ============================================
VITE_APP_URL=http://localhost:8080
