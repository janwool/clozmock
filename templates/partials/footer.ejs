<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="logo-text"><%= t.site.name %></span>
      <p><%= t.site.tagline %></p>
    </div>

    <div class="footer-links">
      <div class="footer-column">
        <h4><%= t.nav.mockups %></h4>
        <% Object.keys(t.categories).forEach(function(cat) { %>
        <a href="<%= lang === 'en' ? '/mockups/' + cat + '/' : '/' + lang + '/mockups/' + cat + '/' %>">
          <%= t.categories[cat] %>
        </a>
        <% }) %>
      </div>

      <div class="footer-column">
        <h4>Company</h4>
        <a href="<%= lang === 'en' ? '/about.html' : '/' + lang + '/about.html' %>"><%= t.footer.about %></a>
        <a href="<%= lang === 'en' ? '/contact.html' : '/' + lang + '/contact.html' %>"><%= t.footer.contact %></a>
        <a href="<%= lang === 'en' ? '/terms.html' : '/' + lang + '/terms.html' %>"><%= t.footer.terms %></a>
        <a href="<%= lang === 'en' ? '/privacy.html' : '/' + lang + '/privacy.html' %>"><%= t.footer.privacy %></a>
      </div>
    </div>

    <div class="footer-bottom">
      <p><%= t.footer.copyright %></p>
    </div>
  </div>
</footer>
